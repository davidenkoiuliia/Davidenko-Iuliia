# AVS field file
#
# AutoDock Atomic Affinity and Electrostatic Grids
#
# Created by .\autogrid4.exe.
#
#SPACING 0.375
#NELEMENTS 20 34 46
#CENTER -0.578 23.227 -0.524
#MACROMOLECULE 3ogq.pdbqt
#GRID_PARAMETER_FILE grid.gpf
#
ndim=3			# number of dimensions in the field
dim1=21			# number of x-elements
dim2=35			# number of y-elements
dim3=47			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=7		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=3ogq.maps.xyz filetype=ascii offset=0
coord 2 file=3ogq.maps.xyz filetype=ascii offset=2
coord 3 file=3ogq.maps.xyz filetype=ascii offset=4
label=A-affinity	# component label for variable 1
label=C-affinity	# component label for variable 2
label=OA-affinity	# component label for variable 3
label=HD-affinity	# component label for variable 4
label=N-affinity	# component label for variable 5
label=Electrostatics	# component label for variable 5
label=Desolvation	# component label for variable 6
#
# location of affinity grid files and how to read them
#
variable 1 file=3ogq.A.map filetype=ascii skip=6
variable 2 file=3ogq.C.map filetype=ascii skip=6
variable 3 file=3ogq.OA.map filetype=ascii skip=6
variable 4 file=3ogq.HD.map filetype=ascii skip=6
variable 5 file=3ogq.N.map filetype=ascii skip=6
variable 6 file=3ogq.e.map filetype=ascii skip=6
variable 7 file=3ogq.d.map filetype=ascii skip=6
