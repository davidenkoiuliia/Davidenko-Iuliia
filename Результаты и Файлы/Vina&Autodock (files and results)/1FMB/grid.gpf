npts 40 28 36                        # num.grid points in xyz
gridfld 1fmb.maps.fld                # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N NA OA SA     # receptor atom types
ligand_types A C OA N S HD           # ligand atom types
receptor 1fmb.pdbqt                  # macromolecule
gridcenter 5.196 20.065 3.725        # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 1fmb.A.map                       # atom-specific affinity map
map 1fmb.C.map                       # atom-specific affinity map
map 1fmb.OA.map                      # atom-specific affinity map
map 1fmb.N.map                       # atom-specific affinity map
map 1fmb.S.map                       # atom-specific affinity map
map 1fmb.HD.map                      # atom-specific affinity map
elecmap 1fmb.e.map                   # electrostatic potential map
dsolvmap 1fmb.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
