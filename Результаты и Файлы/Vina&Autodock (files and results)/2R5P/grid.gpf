npts 28 44 30                        # num.grid points in xyz
gridfld 2r5p.maps.fld                # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N OA SA        # receptor atom types
ligand_types A C HD OA N             # ligand atom types
receptor 2r5p.pdbqt                  # macromolecule
gridcenter 28.934 -11.022 -0.187     # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 2r5p.A.map                       # atom-specific affinity map
map 2r5p.C.map                       # atom-specific affinity map
map 2r5p.HD.map                      # atom-specific affinity map
map 2r5p.OA.map                      # atom-specific affinity map
map 2r5p.N.map                       # atom-specific affinity map
elecmap 2r5p.e.map                   # electrostatic potential map
dsolvmap 2r5p.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
