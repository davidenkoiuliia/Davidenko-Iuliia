# AVS field file
#
# AutoDock Atomic Affinity and Electrostatic Grids
#
# Created by .\autogrid4.exe.
#
#SPACING 0.375
#NELEMENTS 28 22 28
#CENTER 0.426 3.144 18.328
#MACROMOLECULE 3sm1.pdbqt
#GRID_PARAMETER_FILE grid.gpf
#
ndim=3			# number of dimensions in the field
dim1=29			# number of x-elements
dim2=23			# number of y-elements
dim3=29			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=6		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=3sm1.maps.xyz filetype=ascii offset=0
coord 2 file=3sm1.maps.xyz filetype=ascii offset=2
coord 3 file=3sm1.maps.xyz filetype=ascii offset=4
label=C-affinity	# component label for variable 1
label=HD-affinity	# component label for variable 2
label=OA-affinity	# component label for variable 3
label=N-affinity	# component label for variable 4
label=Electrostatics	# component label for variable 4
label=Desolvation	# component label for variable 5
#
# location of affinity grid files and how to read them
#
variable 1 file=3sm1.C.map filetype=ascii skip=6
variable 2 file=3sm1.HD.map filetype=ascii skip=6
variable 3 file=3sm1.OA.map filetype=ascii skip=6
variable 4 file=3sm1.N.map filetype=ascii skip=6
variable 5 file=3sm1.e.map filetype=ascii skip=6
variable 6 file=3sm1.d.map filetype=ascii skip=6
