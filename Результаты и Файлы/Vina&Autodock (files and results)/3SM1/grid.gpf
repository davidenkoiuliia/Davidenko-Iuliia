npts 28 22 28                        # num.grid points in xyz
gridfld 3sm1.maps.fld                # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N OA SA        # receptor atom types
ligand_types C HD OA N               # ligand atom types
receptor 3sm1.pdbqt                  # macromolecule
gridcenter 0.426 3.144 18.328        # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 3sm1.C.map                       # atom-specific affinity map
map 3sm1.HD.map                      # atom-specific affinity map
map 3sm1.OA.map                      # atom-specific affinity map
map 3sm1.N.map                       # atom-specific affinity map
elecmap 3sm1.e.map                   # electrostatic potential map
dsolvmap 3sm1.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
