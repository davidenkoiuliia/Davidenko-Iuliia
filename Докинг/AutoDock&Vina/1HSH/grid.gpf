npts 46 48 42                        # num.grid points in xyz
gridfld 1hsh.maps.fld                # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N OA SA        # receptor atom types
ligand_types A C HD OA N             # ligand atom types
receptor 1hsh.pdbqt                  # macromolecule
gridcenter 10.492 1.418 8.152        # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 1hsh.A.map                       # atom-specific affinity map
map 1hsh.C.map                       # atom-specific affinity map
map 1hsh.HD.map                      # atom-specific affinity map
map 1hsh.OA.map                      # atom-specific affinity map
map 1hsh.N.map                       # atom-specific affinity map
elecmap 1hsh.e.map                   # electrostatic potential map
dsolvmap 1hsh.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
