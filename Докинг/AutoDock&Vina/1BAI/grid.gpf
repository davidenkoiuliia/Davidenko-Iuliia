npts 72 28 40                        # num.grid points in xyz
gridfld 1bai.maps.fld                # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N OA SA        # receptor atom types
ligand_types A C HD OA N             # ligand atom types
receptor 1bai.pdbqt                  # macromolecule
gridcenter -2.904 16.891 35.058      # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 1bai.A.map                       # atom-specific affinity map
map 1bai.C.map                       # atom-specific affinity map
map 1bai.HD.map                      # atom-specific affinity map
map 1bai.OA.map                      # atom-specific affinity map
map 1bai.N.map                       # atom-specific affinity map
elecmap 1bai.e.map                   # electrostatic potential map
dsolvmap 1bai.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
