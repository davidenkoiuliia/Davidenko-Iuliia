npts 42 36 62                        # num.grid points in xyz
gridfld 2p3c.maps.fld                # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N NA OA SA     # receptor atom types
ligand_types A C HD OA N             # ligand atom types
receptor 2p3c.pdbqt                  # macromolecule
gridcenter -6.403 -12.566 14.441     # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 2p3c.A.map                       # atom-specific affinity map
map 2p3c.C.map                       # atom-specific affinity map
map 2p3c.HD.map                      # atom-specific affinity map
map 2p3c.OA.map                      # atom-specific affinity map
map 2p3c.N.map                       # atom-specific affinity map
elecmap 2p3c.e.map                   # electrostatic potential map
dsolvmap 2p3c.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
