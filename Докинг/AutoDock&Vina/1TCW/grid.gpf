npts 30 38 30                        # num.grid points in xyz
gridfld 1tcw.maps.fld                # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N OA SA        # receptor atom types
ligand_types A C HD OA N             # ligand atom types
receptor 1tcw.pdbqt                  # macromolecule
gridcenter 56.789 3.056 20.161       # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 1tcw.A.map                       # atom-specific affinity map
map 1tcw.C.map                       # atom-specific affinity map
map 1tcw.HD.map                      # atom-specific affinity map
map 1tcw.OA.map                      # atom-specific affinity map
map 1tcw.N.map                       # atom-specific affinity map
elecmap 1tcw.e.map                   # electrostatic potential map
dsolvmap 1tcw.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
