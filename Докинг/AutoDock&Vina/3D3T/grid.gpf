npts 36 38 56                        # num.grid points in xyz
gridfld 3d3t.maps.fld                # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N OA SA        # receptor atom types
ligand_types A C HD OA N             # ligand atom types
receptor 3d3t.pdbqt                  # macromolecule
gridcenter 9.384 -12.27 1.152        # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 3d3t.A.map                       # atom-specific affinity map
map 3d3t.C.map                       # atom-specific affinity map
map 3d3t.HD.map                      # atom-specific affinity map
map 3d3t.OA.map                      # atom-specific affinity map
map 3d3t.N.map                       # atom-specific affinity map
elecmap 3d3t.e.map                   # electrostatic potential map
dsolvmap 3d3t.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
