# AVS field file
#
# AutoDock Atomic Affinity and Electrostatic Grids
#
# Created by .\autogrid4.exe.
#
#SPACING 0.375
#NELEMENTS 36 38 56
#CENTER 9.384 -12.270 1.152
#MACROMOLECULE 3d3t.pdbqt
#GRID_PARAMETER_FILE grid.gpf
#
ndim=3			# number of dimensions in the field
dim1=37			# number of x-elements
dim2=39			# number of y-elements
dim3=57			# number of z-elements
nspace=3		# number of physical coordinates per point
veclen=7		# number of affinity values at each point
data=float		# data type (byte, integer, float, double)
field=uniform		# field type (uniform, rectilinear, irregular)
coord 1 file=3d3t.maps.xyz filetype=ascii offset=0
coord 2 file=3d3t.maps.xyz filetype=ascii offset=2
coord 3 file=3d3t.maps.xyz filetype=ascii offset=4
label=A-affinity	# component label for variable 1
label=C-affinity	# component label for variable 2
label=HD-affinity	# component label for variable 3
label=OA-affinity	# component label for variable 4
label=N-affinity	# component label for variable 5
label=Electrostatics	# component label for variable 5
label=Desolvation	# component label for variable 6
#
# location of affinity grid files and how to read them
#
variable 1 file=3d3t.A.map filetype=ascii skip=6
variable 2 file=3d3t.C.map filetype=ascii skip=6
variable 3 file=3d3t.HD.map filetype=ascii skip=6
variable 4 file=3d3t.OA.map filetype=ascii skip=6
variable 5 file=3d3t.N.map filetype=ascii skip=6
variable 6 file=3d3t.e.map filetype=ascii skip=6
variable 7 file=3d3t.d.map filetype=ascii skip=6
