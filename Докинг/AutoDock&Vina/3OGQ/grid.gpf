npts 20 34 46                        # num.grid points in xyz
gridfld 3ogq.maps.fld                # grid_data_file
spacing 0.375                        # spacing(A)
receptor_types A C HD N OA SA        # receptor atom types
ligand_types A C OA HD N             # ligand atom types
receptor 3ogq.pdbqt                  # macromolecule
gridcenter -0.578 23.227 -0.524      # xyz-coordinates or auto
smooth 0.5                           # store minimum energy w/in rad(A)
map 3ogq.A.map                       # atom-specific affinity map
map 3ogq.C.map                       # atom-specific affinity map
map 3ogq.OA.map                      # atom-specific affinity map
map 3ogq.HD.map                      # atom-specific affinity map
map 3ogq.N.map                       # atom-specific affinity map
elecmap 3ogq.e.map                   # electrostatic potential map
dsolvmap 3ogq.d.map              # desolvation potential map
dielectric -0.1465                   # <0, AD4 distance-dep.diel;>0, constant
